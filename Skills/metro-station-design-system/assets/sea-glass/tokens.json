{
  "schemaVersion": "1.0",
  "name": "Metro Sea Glass",
  "status": "experimental",
  "platform": {"minimumIOS": "26.0", "swiftLanguageMode": "6"},
  "recipe": {
    "nativeBackdrop": "SwiftUI.Material.ultraThinMaterial",
    "customLayers": ["muted pigment", "static scattering", "static micrograin", "worn bevel", "perimeter reflection"],
    "optics": "illustrated, not physically simulated",
    "foreground": "separate unfiltered content"
  },
  "presets": {
    "tide": {"srgb": [0.34, 0.84, 0.82], "hexApproximation": "#57D6D1", "opaqueDark": [0.10, 0.24, 0.25], "opaqueLight": [0.78, 0.91, 0.88]},
    "kelp": {"srgb": [0.57, 0.76, 0.48], "hexApproximation": "#91C27A", "opaqueDark": [0.17, 0.23, 0.15], "opaqueLight": [0.85, 0.91, 0.77]},
    "amber": {"srgb": [0.94, 0.72, 0.39], "hexApproximation": "#F0B863", "opaqueDark": [0.28, 0.21, 0.12], "opaqueLight": [0.96, 0.88, 0.73]},
    "violet": {"srgb": [0.69, 0.59, 0.84], "hexApproximation": "#B096D6", "opaqueDark": [0.22, 0.18, 0.29], "opaqueLight": [0.89, 0.84, 0.95]},
    "frost": {"srgb": [0.82, 0.89, 0.88], "hexApproximation": "#D1E3E0", "opaqueDark": [0.19, 0.25, 0.26], "opaqueLight": [0.91, 0.94, 0.92]}
  },
  "configuration": {
    "frost": {"default": 0.64, "range": [0, 1], "meaning": "custom milky overlay, not system blur radius"},
    "depth": {"default": 0.55, "range": [0, 1], "meaning": "illustrated bevel and shadow"},
    "grain": {"default": 0.45, "range": [0, 1], "meaning": "static fine grain intensity"},
    "lightDirection": {"default": [-0.65, -0.76], "maximumVectorLength": 1, "coordinateSystem": "screen: positive x right, positive y down", "scope": "perimeter arc only"},
    "forceOpaque": {"default": false, "meaning": "preview opaque fallback; ORed with system Reduce Transparency"},
    "staticLight": {"default": false, "meaning": "preview fixed upper-leading light; ORed with system Reduce Motion"}
  },
  "geometry": {
    "defaultCornerRadiusPoints": 28,
    "buttonCornerRadiusPoints": 24,
    "minimumButtonSizePoints": [44, 44],
    "buttonPaddingPoints": {"horizontal": 18, "vertical": 12},
    "bevelWidthPoints": {"base": 2, "depthMultiplier": 4},
    "reflectionLineWidthPoints": {"base": 0.85, "depthMultiplier": 0.55}
  },
  "renderingBounds": {
    "grainMaximumDotCount": 2400,
    "grainAreaPointsPerDot": 12,
    "grainDiameterPoints": [0.35, 1.0],
    "rimInterpolationSeconds": 0,
    "autonomousAnimation": false,
    "sensorOwnership": "host"
  },
  "accessibility": {
    "reduceTransparency": "opaque tint-specific fill, no grain or moving reflection",
    "reduceMotion": "static upper-leading rim, no interpolation",
    "increasedContrast": "stronger 1.6-point perimeter",
    "decorativeHitTesting": false,
    "readoutGeometry": "independent of light direction"
  }
}
